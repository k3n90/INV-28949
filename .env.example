# Скопируйте в .env и укажите значения.

# Токен бота из Telegram.
BOT_TOKEN=
# Числовой id админов из Telegram. Возможно несколько id через запятую.
ADMIN_IDS=

# Длинная случайная строка - секрет бота и API.
INTERNAL_TOKEN=

# Длинная случайная строка - Telegram для secret_token. Только латиница, цифры и символы "_" и "-".
WEBHOOK_SECRET=

# На локалке http://localhost:8080.
WEBAPP_URL=http://localhost:8080
PUBLIC_BASE_URL=http://localhost:8080

# Данные Постгри и MinIO — только латиница, цифры и символ "-".
POSTGRES_USER=INV-28949
POSTGRES_PASSWORD=
POSTGRES_DB=shop

MINIO_ROOT_USER=INV-28949
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=goods
