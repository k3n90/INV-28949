# Скопируйте в .env и укажите значения.

# Токен бота из Telegram.
BOT_TOKEN=
# Числовой id админов из Telegram. Возможно несколько id через запятую.
ADMIN_IDS=

# Длинная случайная строка - секрет бота и API.
INTERNAL_TOKEN=

# Длинная случайная строка - Telegram для secret_token. Только латиница, цифры и символы "_" и "-".
WEBHOOK_SECRET=

# Необязательный прокси до api.telegram.org, если с сервера он недоступен напрямую (ркн блочат :( ).
TELEGRAM_PROXY=

# Метод работы бота.
# polling — бот сам забирает сообщения через прокси.
# webhook — Telegram подключается к сайту.
# (webhook не для РФ хоста)
BOT_MODE=polling

# На локалке http://localhost:8090.
# На сервере адрес хоста.
WEBAPP_URL=http://localhost:8090
PUBLIC_BASE_URL=http://localhost:8090

# Данные Постгри и MinIO — только латиница, цифры и символ "-".
POSTGRES_USER=INV-28949
POSTGRES_PASSWORD=
POSTGRES_DB=shop

MINIO_ROOT_USER=INV-28949
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=goods
